# Secrets — never commit
secrets/
*.token
ifind_token.json
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# data caches (large files)
data/cache/
data/*.parquet
data/*.csv

# outputs (deliverables re-generated by scripts; keep .md only)
outputs/**/*.csv
outputs/**/*.html
outputs/**/*.json
outputs/**/*.parquet

# logs & tmp
logs/
.ipynb_checkpoints/
/tmp/
.worktrees/

# site build artifacts
site/node_modules/
site/.vitepress/dist/
site/.vitepress/cache/

# 构建期同步产物（site/scripts/sync-docs.mjs 生成，不入库）
site/docs/
site/public/diagrams/
site/.vitepress/docs-manifest.json
