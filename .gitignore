# Secrets — never commit
secrets/
*.token
ifind_token.json
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# data caches (large files)
data/cache/
data/*.parquet
data/*.csv

# outputs (deliverables re-generated by scripts; keep .md only)
outputs/**/*.csv
outputs/**/*.html
outputs/**/*.json

# logs & tmp
logs/
.ipynb_checkpoints/
/tmp/
.worktrees/
